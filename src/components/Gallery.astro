---
import OptimizedImage from './OptimizedImage.astro'
import Lightbox from './Lightbox.astro'
import { imageRatio, justifiedSizes, viewerSources } from '../lib/image'
import type { SanityImage } from '../lib/queries'

interface Props {
  photos: SanityImage[]
  title: string
}

const { photos, title } = Astro.props

// Same justified-row geometry as the event catalog, with taller rows: a series
// is there to be looked at, not searched, so each photo gets more room while
// the phone still shows several at once. Keep in sync with --gal-row below —
// sizes= is derived from these numbers.
const ROW_H = { sm: 108, md: 170, lg: 240 }

// Precompute the viewer URLs server-side (no urlFor on the client).
const items = photos.map((photo, i) => {
  const ratio = imageRatio(photo)
  return {
    photo,
    index: i,
    num: String(i + 1).padStart(2, '0'),
    ratio,
    view: viewerSources(photo),
    alt: photo.alt ?? title,
    caption: photo.caption ?? '',
    capture: photo.captureInfo ?? '',
    sizes: justifiedSizes(ratio, ROW_H),
  }
})
---

{
  items.length === 0 ? (
    <p class="gallery-empty wrap" data-reveal>
      <span data-lang-block="en">There are no photos in this series yet.</span>
      <span data-lang-block="es">Todavía no hay fotografías en esta serie.</span>
    </p>
  ) : (
    <div class="gallery wrap">
      {items.map((it) => (
        <button
          class="shot"
          type="button"
          data-lightbox-open
          data-index={it.index}
          data-full={it.view.src}
          data-full-srcset={it.view.srcset}
          data-full-sizes={it.view.sizes}
          data-alt={it.alt}
          data-caption={it.caption}
          data-capture={it.capture}
          data-reveal
          style={`--r:${it.ratio.toFixed(4)};--reveal-delay:${(it.index % 4) * 0.05}s`}
          aria-label={`Ampliar foto ${it.num}: ${it.alt}`}
        >
          <OptimizedImage
            image={it.photo}
            alt={it.alt}
            sizes={it.sizes}
            ratio={it.ratio}
            eager={it.index < 4}
            class="shot__img"
          />
          <span class="shot__cap" aria-hidden="true">
            {it.caption || it.alt}
          </span>
        </button>
      ))}
    </div>
  )
}

<Lightbox />

<style>
  .gallery-empty {
    color: var(--text-dim);
    font-size: var(--step-1);
    padding-block: 4rem;
  }

  /* Justified rows, same geometry as the event catalog: --r is the photo's
     real ratio, and matching flex-basis/flex-grow make every item in a row
     scale by one factor, so the heights line up on their own. Column masonry
     went one-per-screen on a phone and ordered photos down a column instead
     of across, which read as unrelated strips rather than a series. */
  .gallery {
    --gal-row: 108px;
    --gal-gap: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gal-gap);
  }
  /* Absorbs the slack so the final photo is not stretched into a feature. */
  .gallery::after {
    content: '';
    flex: 99999 1 0;
  }
  @media (min-width: 640px) {
    .gallery {
      --gal-row: 170px;
      --gal-gap: 6px;
    }
  }
  @media (min-width: 1000px) {
    .gallery {
      --gal-row: 240px;
      --gal-gap: 8px;
    }
  }

  .shot {
    display: block;
    position: relative;
    flex: var(--r) 1 calc(var(--r) * var(--gal-row));
    padding: 0;
    margin: 0;
    overflow: hidden;
    background: var(--surface);
    text-align: left;
  }

  .shot :global(.shot__img) {
    transition: transform 0.9s var(--ease-out), filter 0.6s var(--ease);
    filter: saturate(0.94) brightness(0.98);
  }
  .shot:hover :global(.shot__img),
  .shot:focus-visible :global(.shot__img) {
    transform: scale(1.04);
    filter: saturate(1.05) brightness(1);
  }

  /* Hover: reveal caption/title over the image. Hidden at the densest
     breakpoint — the tiles are too small to read a caption on, and a touch
     device can leave :hover stuck on the last photo tapped. */
  .shot__cap {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    padding: 1.4rem 0.9rem 0.85rem;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--text);
    background: linear-gradient(
      to top,
      rgba(15, 15, 17, 0.9),
      rgba(15, 15, 17, 0)
    );
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }
  @media (min-width: 640px) {
    .shot__cap {
      display: block;
    }
  }
  .shot:hover .shot__cap,
  .shot:focus-visible .shot__cap {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot__cap {
      transition: none;
    }
  }
</style>
