---
/**
 * Shared full-screen photo viewer (carousel).
 *
 * Any page can drive it: render one Lightbox and mark each thumbnail with
 * [data-lightbox-open] plus the payload it should show:
 *   data-index     position in the set (0-based)
 *   data-full      large image URL
 *   data-alt       alt text
 *   data-caption   caption line (falls back to alt)
 *   data-capture   secondary meta line (optional)
 *   data-code      photo code, shown next to the order CTA (optional)
 *   data-order     order link — its presence shows the CTA (optional)
 *   data-protected blocks drag / right-click on the viewer image (optional)
 */
---

<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de fotografía ampliada"
  hidden
>
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="Cerrar visor">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Foto anterior">
    <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <figure class="lightbox__stage">
    <div class="lightbox__frame">
      <img class="lightbox__img" id="lightbox-img" src="" alt="" />
      <div class="lightbox__order" id="lightbox-order" hidden>
        <span class="lightbox__code" id="lightbox-code"></span>
        <a
          class="lightbox__cta"
          id="lightbox-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span data-lang-block="en">Order →</span
          ><span data-lang-block="es">La quiero →</span>
        </a>
      </div>
    </div>
    <figcaption class="lightbox__caption">
      <span id="lightbox-text"></span>
      <span class="lightbox__meta" id="lightbox-meta" hidden></span>
    </figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Foto siguiente">
    <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 5l7 7-7 7"/></svg>
  </button>
</div>

<style>
  /* Always dark, regardless of the site theme — a full-screen photo viewer
     reads best on black. Local vars keep its controls legible on that dark
     backdrop in both light and dark site themes. */
  .lightbox {
    --lb-fg: #ece4d8;
    --lb-line: rgba(255, 255, 255, 0.16);
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.25rem, 2vw, 1.5rem);
    padding: clamp(0.75rem, 3vw, 2.5rem);
    background: rgba(12, 12, 14, 0.95);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.is-open {
    opacity: 1;
  }

  .lightbox__stage {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-width: 0;
    height: 100%;
  }
  .lightbox__frame {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 0;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    transition: filter 0.3s var(--ease);
  }
  /* While the grid thumbnail stands in for the full size, blur it: an upscaled
     preview reads as "arriving" instead of as a soft photo, and it also stops
     anyone mistaking the stand-in for the file they are about to order. It is
     the same frame either way, so the code beside it is never wrong. */
  .lightbox__img.is-bridging {
    filter: blur(10px);
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox__img {
      transition: none;
    }
  }
  .lightbox__caption {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--lb-fg) 65%, transparent);
  }
  .lightbox__meta {
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--lb-fg) 45%, transparent);
  }
  .lightbox__meta[hidden] {
    display: none;
  }

  /* Order bar rides on the photo, same scrim as the catalog grid: the code
     stays welded to the image it names, and the client orders what they are
     actually looking at instead of hunting for it back in the grid. */
  .lightbox__order {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 4vw, 2rem);
    padding: 2rem 0.8rem 0.6rem;
    background: linear-gradient(
      to top,
      rgba(10, 10, 12, 0.88),
      rgba(10, 10, 12, 0.55) 55%,
      rgba(10, 10, 12, 0)
    );
  }
  .lightbox__order[hidden] {
    display: none;
  }
  .lightbox__code {
    padding-left: 0.3rem;
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--lb-fg);
  }
  .lightbox__cta {
    display: inline-flex;
    align-items: center;
    /* Same reasoning as the grid CTA: comfortable thumb target, not a
       hairline of text. */
    min-height: 2.9rem;
    padding: 0 1.2rem;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lb-fg);
    transition: color 0.25s var(--ease);
  }
  .lightbox__cta:hover,
  .lightbox__cta:focus-visible {
    color: var(--accent-bright);
  }

  .lightbox__close {
    position: absolute;
    top: clamp(0.75rem, 3vw, 2rem);
    right: clamp(0.75rem, 3vw, 2rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--lb-fg);
    border: 1px solid var(--lb-line);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .lightbox__close:hover {
    color: var(--accent-bright);
    border-color: var(--accent-bright);
    transform: rotate(90deg);
  }

  .lightbox__nav {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: color-mix(in srgb, var(--lb-fg) 70%, transparent);
    border: 1px solid transparent;
    border-radius: 50%;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease),
      background 0.25s var(--ease);
  }
  .lightbox__nav:hover {
    color: var(--lb-fg);
    border-color: var(--lb-line);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 640px) {
    /* Carousel arrows centered vertically on the sides, over the image. */
    .lightbox__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      background: color-mix(in srgb, rgba(12, 12, 14, 1) 55%, transparent);
      backdrop-filter: blur(4px);
    }
    .lightbox__nav--prev {
      left: 0.4rem;
    }
    .lightbox__nav--next {
      right: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none;
    }
  }
</style>

<script>
  interface Slide {
    full: string
    srcset: string
    sizes: string
    alt: string
    caption: string
    capture: string
    code: string
    order: string
    protectedImage: boolean
    num: string
    trigger: HTMLElement
  }

  function initLightbox() {
    const box = document.getElementById('lightbox')
    if (!box) return

    const img = document.getElementById('lightbox-img') as HTMLImageElement | null
    const textEl = document.getElementById('lightbox-text')
    const metaEl = document.getElementById('lightbox-meta')
    const orderEl = document.getElementById('lightbox-order')
    const codeEl = document.getElementById('lightbox-code')
    const ctaEl = document.getElementById('lightbox-cta') as HTMLAnchorElement | null
    if (!img || !textEl) return

    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>('[data-lightbox-open]')
    )

    const slides: Slide[] = triggers.map((t) => ({
      full: t.dataset.full || '',
      // Optional: a page that offers no srcset still works, it just always
      // serves the 2000px file.
      srcset: t.dataset.fullSrcset || '',
      sizes: t.dataset.fullSizes || '',
      alt: t.dataset.alt || '',
      caption: t.dataset.caption || '',
      capture: t.dataset.capture || '',
      code: t.dataset.code || '',
      order: t.dataset.order || '',
      protectedImage: t.dataset.protected != null,
      num: String(Number(t.dataset.index) + 1).padStart(2, '0'),
      trigger: t,
    }))

    let current = 0
    let lastFocused: HTMLElement | null = null

    // Neighbours are fetched as soon as you land, so by the time you actually
    // move they are in the HTTP cache and the swap is instant.
    const warm = new Map<string, HTMLImageElement>()
    const WARM_MAX = 12

    const preload = (i: number) => {
      const s = slides[(i + slides.length) % slides.length]
      if (!s?.full || warm.has(s.full)) return
      const im = new Image()
      im.decoding = 'async'
      // Must mirror what render() will ask for, or the browser warms one
      // candidate and then fetches a different one — a preload that costs
      // bandwidth and saves nothing.
      if (s.sizes) im.sizes = s.sizes
      if (s.srcset) im.srcset = s.srcset
      im.src = s.full
      warm.set(s.full, im)
      // A 200-photo event would otherwise pin every full-size decode in
      // memory. Keep a short trailing window and drop the oldest.
      if (warm.size > WARM_MAX) {
        const oldest = warm.keys().next().value
        if (oldest) warm.delete(oldest)
      }
    }

    /**
     * Show the slide's photo immediately, at whatever resolution is already
     * available, and upgrade it in place.
     *
     * The grid has already downloaded and decoded a thumbnail of this exact
     * photo, so painting that costs nothing and is instant. Without it the
     * <img> kept showing the PREVIOUS photo while a cold full-size request
     * ran — and because the code and caption update synchronously, the viewer
     * briefly showed one photo's code beside another photo's image. That is
     * the wrong-photo-ordered confusion the grid layout was fixed for, arriving
     * here through timing instead. The bridge is the same frame, so the numbers
     * beside it are true from the first paint.
     */
    const paintBridged = (s: Slide) => {
      const applyFull = () => {
        img.sizes = s.sizes
        img.srcset = s.srcset
        img.src = s.full
        img.classList.remove('is-bridging')
      }
      const showFull = () => {
        // Guard against a fast swiper: this callback may resolve after the
        // reader has already moved on.
        if (slides[current] !== s) return
        applyFull()
      }

      const thumb = s.trigger.querySelector('img')
      const bridge = thumb?.currentSrc || thumb?.src || ''
      if (!bridge || bridge === s.full) {
        applyFull()
        return
      }

      // srcset outranks src, so it has to be cleared first — otherwise the
      // browser keeps resolving against the old candidate list and the
      // thumbnail never paints.
      img.srcset = ''
      img.sizes = ''
      img.src = bridge
      img.classList.add('is-bridging')

      const full = new Image()
      full.decoding = 'async'
      if (s.sizes) full.sizes = s.sizes
      if (s.srcset) full.srcset = s.srcset
      full.addEventListener('load', showFull)
      full.src = s.full
      if (full.complete && full.naturalWidth > 0) showFull()
    }

    const render = () => {
      const s = slides[current]
      if (!s) return

      paintBridged(s)
      img.alt = s.alt
      // Friction against the lazy grab, same as in the catalog grid — the
      // burnt-in watermark is what actually defends the work.
      img.draggable = !s.protectedImage
      textEl.textContent = s.caption || s.alt
      if (metaEl) {
        metaEl.textContent = s.capture
        metaEl.hidden = !s.capture
      }
      if (orderEl && codeEl && ctaEl) {
        const hasOrder = Boolean(s.order)
        orderEl.hidden = !hasOrder
        codeEl.textContent = s.code
        if (hasOrder) {
          ctaEl.href = s.order
          ctaEl.setAttribute('aria-label', `La quiero — foto ${s.code}`)
        } else {
          ctaEl.removeAttribute('href')
        }
      }

      // Warm both directions: people browse a catalog backwards as often as
      // forwards, hunting for the frame they just scrolled past.
      preload(current + 1)
      preload(current - 1)
    }

    const open = (index: number) => {
      current = index
      lastFocused = document.activeElement as HTMLElement
      render()
      box.hidden = false
      // next frame → CSS transition
      requestAnimationFrame(() => box.classList.add('is-open'))
      document.body.style.overflow = 'hidden'
      ;(box.querySelector('[data-lightbox-close]') as HTMLElement)?.focus()
    }

    const close = () => {
      box.classList.remove('is-open')
      document.body.style.overflow = ''
      const done = () => {
        box.hidden = true
        box.removeEventListener('transitionend', done)
      }
      // respect reduced motion (no transition → hide immediately)
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        box.hidden = true
      } else {
        box.addEventListener('transitionend', done)
      }
      lastFocused?.focus()
    }

    const go = (dir: number) => {
      current = (current + dir + slides.length) % slides.length
      render()
    }

    triggers.forEach((t, i) => t.addEventListener('click', () => open(i)))
    box.querySelector('[data-lightbox-close]')?.addEventListener('click', close)
    box
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => go(-1))
    box
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => go(1))

    img.addEventListener('contextmenu', (e) => {
      if (slides[current]?.protectedImage) e.preventDefault()
    })

    // backdrop click (only when the grid container itself is clicked)
    box.addEventListener('click', (e) => {
      if (e.target === box) close()
    })

    // keyboard: Esc / arrows + focus trap
    box.addEventListener('keydown', (e) => {
      if (box.hidden) return
      if (e.key === 'Escape') {
        close()
      } else if (e.key === 'ArrowRight') {
        go(1)
      } else if (e.key === 'ArrowLeft') {
        go(-1)
      } else if (e.key === 'Tab') {
        // The order CTA is an anchor, so the trap has to include links — and
        // skip whatever is hidden on the current slide.
        const focusables = Array.from(
          box.querySelectorAll<HTMLElement>('button:not([disabled]), a[href]')
        ).filter((el) => el.offsetParent !== null)
        if (!focusables.length) return
        const first = focusables[0]
        const last = focusables[focusables.length - 1]
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault()
          last.focus()
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault()
          first.focus()
        }
      }
    })

    // Touch swipe (mobile): swipe left → next photo, right → previous.
    let touchX = 0
    let touchY = 0
    box.addEventListener(
      'touchstart',
      (e) => {
        touchX = e.changedTouches[0].screenX
        touchY = e.changedTouches[0].screenY
      },
      { passive: true }
    )
    box.addEventListener(
      'touchend',
      (e) => {
        if (box.hidden) return
        const dx = e.changedTouches[0].screenX - touchX
        const dy = e.changedTouches[0].screenY - touchY
        // Horizontal intent only, past a minimum distance — ignore taps/scrolls.
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
          go(dx < 0 ? 1 : -1)
        }
      },
      { passive: true }
    )
  }

  initLightbox()
  document.addEventListener('astro:page-load', initLightbox)
</script>
