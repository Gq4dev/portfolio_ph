---
/**
 * Shared full-screen photo viewer (carousel).
 *
 * Any page can drive it: render one Lightbox and mark each thumbnail with
 * [data-lightbox-open] plus the payload it should show:
 *   data-index     position in the set (0-based)
 *   data-full      large image URL
 *   data-alt       alt text
 *   data-caption   caption line (falls back to alt)
 *   data-capture   secondary meta line (optional)
 *   data-code      photo code, shown next to the order CTA (optional)
 *   data-order     order link — its presence shows the CTA (optional)
 *   data-protected blocks drag / right-click on the viewer image (optional)
 */
---

<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de fotografía ampliada"
  hidden
>
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="Cerrar visor">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Foto anterior">
    <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <figure class="lightbox__stage">
    <img class="lightbox__img" id="lightbox-img" src="" alt="" />
    <figcaption class="lightbox__caption">
      <span id="lightbox-text"></span>
      <span class="lightbox__meta" id="lightbox-meta" hidden></span>
    </figcaption>
    <div class="lightbox__order" id="lightbox-order" hidden>
      <span class="lightbox__code" id="lightbox-code"></span>
      <a
        class="lightbox__cta"
        id="lightbox-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-lang-block="en">Order →</span
        ><span data-lang-block="es">Pedir →</span>
      </a>
    </div>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Foto siguiente">
    <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 5l7 7-7 7"/></svg>
  </button>
</div>

<style>
  /* Always dark, regardless of the site theme — a full-screen photo viewer
     reads best on black. Local vars keep its controls legible on that dark
     backdrop in both light and dark site themes. */
  .lightbox {
    --lb-fg: #ece4d8;
    --lb-line: rgba(255, 255, 255, 0.16);
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.25rem, 2vw, 1.5rem);
    padding: clamp(0.75rem, 3vw, 2.5rem);
    background: rgba(12, 12, 14, 0.95);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.is-open {
    opacity: 1;
  }

  .lightbox__stage {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-width: 0;
    height: 100%;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  /* The order bar takes vertical room; give the image less of it so the CTA
     never falls below the fold on short viewports. */
  .lightbox.has-order .lightbox__img {
    max-height: 68vh;
  }
  .lightbox__caption {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--lb-fg) 65%, transparent);
  }
  .lightbox__meta {
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--lb-fg) 45%, transparent);
  }
  .lightbox__meta[hidden] {
    display: none;
  }

  /* Order bar: code plus CTA, so the client can order the photo they are
     actually looking at instead of going back to hunt for it in the grid. */
  .lightbox__order {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 2rem);
    padding-top: 0.85rem;
    border-top: 1px solid var(--lb-line);
  }
  .lightbox__order[hidden] {
    display: none;
  }
  .lightbox__code {
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--lb-fg);
  }
  .lightbox__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lb-fg);
    border: 1px solid var(--lb-line);
    border-radius: 999px;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease),
      background 0.25s var(--ease);
  }
  .lightbox__cta:hover,
  .lightbox__cta:focus-visible {
    color: var(--accent-bright);
    border-color: var(--accent-bright);
    background: rgba(255, 255, 255, 0.06);
  }

  .lightbox__close {
    position: absolute;
    top: clamp(0.75rem, 3vw, 2rem);
    right: clamp(0.75rem, 3vw, 2rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--lb-fg);
    border: 1px solid var(--lb-line);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .lightbox__close:hover {
    color: var(--accent-bright);
    border-color: var(--accent-bright);
    transform: rotate(90deg);
  }

  .lightbox__nav {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: color-mix(in srgb, var(--lb-fg) 70%, transparent);
    border: 1px solid transparent;
    border-radius: 50%;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease),
      background 0.25s var(--ease);
  }
  .lightbox__nav:hover {
    color: var(--lb-fg);
    border-color: var(--lb-line);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 640px) {
    /* Carousel arrows centered vertically on the sides, over the image. */
    .lightbox__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      background: color-mix(in srgb, rgba(12, 12, 14, 1) 55%, transparent);
      backdrop-filter: blur(4px);
    }
    .lightbox__nav--prev {
      left: 0.4rem;
    }
    .lightbox__nav--next {
      right: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none;
    }
  }
</style>

<script>
  interface Slide {
    full: string
    alt: string
    caption: string
    capture: string
    code: string
    order: string
    protectedImage: boolean
    num: string
    trigger: HTMLElement
  }

  function initLightbox() {
    const box = document.getElementById('lightbox')
    if (!box) return

    const img = document.getElementById('lightbox-img') as HTMLImageElement | null
    const textEl = document.getElementById('lightbox-text')
    const metaEl = document.getElementById('lightbox-meta')
    const orderEl = document.getElementById('lightbox-order')
    const codeEl = document.getElementById('lightbox-code')
    const ctaEl = document.getElementById('lightbox-cta') as HTMLAnchorElement | null
    if (!img || !textEl) return

    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>('[data-lightbox-open]')
    )

    const slides: Slide[] = triggers.map((t) => ({
      full: t.dataset.full || '',
      alt: t.dataset.alt || '',
      caption: t.dataset.caption || '',
      capture: t.dataset.capture || '',
      code: t.dataset.code || '',
      order: t.dataset.order || '',
      protectedImage: t.dataset.protected != null,
      num: String(Number(t.dataset.index) + 1).padStart(2, '0'),
      trigger: t,
    }))

    let current = 0
    let lastFocused: HTMLElement | null = null

    const render = () => {
      const s = slides[current]
      if (!s) return
      img.src = s.full
      img.alt = s.alt
      // Friction against the lazy grab, same as in the catalog grid — the
      // burnt-in watermark is what actually defends the work.
      img.draggable = !s.protectedImage
      textEl.textContent = s.caption || s.alt
      if (metaEl) {
        metaEl.textContent = s.capture
        metaEl.hidden = !s.capture
      }
      if (orderEl && codeEl && ctaEl) {
        const hasOrder = Boolean(s.order)
        orderEl.hidden = !hasOrder
        box.classList.toggle('has-order', hasOrder)
        codeEl.textContent = s.code
        if (hasOrder) {
          ctaEl.href = s.order
          ctaEl.setAttribute('aria-label', `Pedir la foto ${s.code}`)
        } else {
          ctaEl.removeAttribute('href')
        }
      }
    }

    const open = (index: number) => {
      current = index
      lastFocused = document.activeElement as HTMLElement
      render()
      box.hidden = false
      // next frame → CSS transition
      requestAnimationFrame(() => box.classList.add('is-open'))
      document.body.style.overflow = 'hidden'
      ;(box.querySelector('[data-lightbox-close]') as HTMLElement)?.focus()
    }

    const close = () => {
      box.classList.remove('is-open')
      document.body.style.overflow = ''
      const done = () => {
        box.hidden = true
        box.removeEventListener('transitionend', done)
      }
      // respect reduced motion (no transition → hide immediately)
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        box.hidden = true
      } else {
        box.addEventListener('transitionend', done)
      }
      lastFocused?.focus()
    }

    const go = (dir: number) => {
      current = (current + dir + slides.length) % slides.length
      render()
    }

    triggers.forEach((t, i) => t.addEventListener('click', () => open(i)))
    box.querySelector('[data-lightbox-close]')?.addEventListener('click', close)
    box
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => go(-1))
    box
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => go(1))

    img.addEventListener('contextmenu', (e) => {
      if (slides[current]?.protectedImage) e.preventDefault()
    })

    // backdrop click (only when the grid container itself is clicked)
    box.addEventListener('click', (e) => {
      if (e.target === box) close()
    })

    // keyboard: Esc / arrows + focus trap
    box.addEventListener('keydown', (e) => {
      if (box.hidden) return
      if (e.key === 'Escape') {
        close()
      } else if (e.key === 'ArrowRight') {
        go(1)
      } else if (e.key === 'ArrowLeft') {
        go(-1)
      } else if (e.key === 'Tab') {
        // The order CTA is an anchor, so the trap has to include links — and
        // skip whatever is hidden on the current slide.
        const focusables = Array.from(
          box.querySelectorAll<HTMLElement>('button:not([disabled]), a[href]')
        ).filter((el) => el.offsetParent !== null)
        if (!focusables.length) return
        const first = focusables[0]
        const last = focusables[focusables.length - 1]
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault()
          last.focus()
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault()
          first.focus()
        }
      }
    })

    // Touch swipe (mobile): swipe left → next photo, right → previous.
    let touchX = 0
    let touchY = 0
    box.addEventListener(
      'touchstart',
      (e) => {
        touchX = e.changedTouches[0].screenX
        touchY = e.changedTouches[0].screenY
      },
      { passive: true }
    )
    box.addEventListener(
      'touchend',
      (e) => {
        if (box.hidden) return
        const dx = e.changedTouches[0].screenX - touchX
        const dy = e.changedTouches[0].screenY - touchY
        // Horizontal intent only, past a minimum distance — ignore taps/scrolls.
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
          go(dx < 0 ? 1 : -1)
        }
      },
      { passive: true }
    )
  }

  initLightbox()
  document.addEventListener('astro:page-load', initLightbox)
</script>
