---
import Layout from '../layouts/Layout.astro'
import OptimizedImage from '../components/OptimizedImage.astro'
import CategoryCard from '../components/CategoryCard.astro'
import { getSiteSettings, getCategories } from '../lib/queries'
import { collectionCount } from '../lib/i18n'
import { urlFor } from '../lib/image'
import { metaDescription } from '../lib/seo'

const [settings, categories] = await Promise.all([
  getSiteSettings(),
  getCategories(),
])

const collections = collectionCount(categories.length)

// Orphan fill for the 3-col grid: a lone last card spans the full row (3),
// the tail of a two-card last row spans the remaining pair (2). Only takes
// effect at >1100px — see CategoryCard's media query.
const seriesTotal = categories.length
const seriesSpan = (i: number): 1 | 2 | 3 => {
  const rem = seriesTotal % 3
  if (i !== seriesTotal - 1) return 1
  if (rem === 1) return 3
  if (rem === 2) return 2
  return 1
}
const heroIntroEn =
  settings.shortBioEn ||
  'Photography that chases honest light — portraits, landscape, and the wildlife that shows up when you stay still.'

// Hero image (LCP): featured[0] → else first category cover/photo.
const heroImage = settings.featured[0] ?? categories[0]?.cover ?? null
const heroAlt =
  settings.featured[0]?.alt ??
  categories[0]?.cover?.alt ??
  settings.title

// Shared hero image config — used by both the preload link and OptimizedImage
// so the preloaded URL matches what the <img> requests (same cache entry).
const HERO_SIZES = '100vw'
const HERO_WIDTHS = [600, 900, 1200, 1600, 2000, 2560]
const heroSrcset = heroImage
  ? HERO_WIDTHS.map(
      (w) => `${urlFor(heroImage).width(w).auto('format').quality(80).url()} ${w}w`
    ).join(', ')
  : undefined

const [firstName, ...rest] = settings.title.split(' ')
const lastName = rest.join(' ')

const description = metaDescription(
  heroIntroEn,
  seriesTotal > 0 ? `Browse ${seriesTotal} photo series.` : null
)
---

<Layout
  title={`${settings.title} — ${settings.tagline}`}
  description={description}
  preloadSrcset={heroSrcset}
  preloadSizes={HERO_SIZES}
>
  <section
    class:list={['hero', { 'hero--has-image': heroImage }]}
    aria-labelledby="hero-name"
  >
    {
      heroImage && (
        <div class="hero__media" data-reveal style="--reveal-delay:0.05s">
          <OptimizedImage
            image={heroImage}
            alt={heroAlt}
            sizes={HERO_SIZES}
            widths={HERO_WIDTHS}
            eager={true}
            class="hero__img"
          />
        </div>
      )
    }
    <h1 class="hero__name" id="hero-name">
      <span class="hero__line" data-reveal style="--reveal-delay:0.12s"
        >{firstName}</span
      >
      {
        lastName && (
          <span class="hero__line" data-reveal style="--reveal-delay:0.22s">
            {lastName}
          </span>
        )
      }
    </h1>
  </section>

  <section class="series wrap" id="series" aria-labelledby="series-title">
    <header class="series__head">
      <h2 class="series__title" id="series-title" data-reveal>Series</h2>
      <p class="series__meta" data-reveal style="--reveal-delay:0.08s">
        <span data-lang-block="en">{collections.en}</span
        ><span data-lang-block="es">{collections.es}</span>
      </p>
    </header>

    {
      categories.length === 0 ? (
        <p class="series__empty" data-reveal>
          <span data-lang-block="en">Series coming soon.</span
          ><span data-lang-block="es">Las series se publicarán pronto.</span>
        </p>
      ) : (
        <div class="series__grid">
          {categories.map((category, i) => (
            <CategoryCard
              category={category}
              index={i}
              span={seriesSpan(i)}
            />
          ))}
        </div>
      )
    }
  </section>
</Layout>

<style>
  /* ---------------- Hero: name centered over a full-bleed image ---------------- */
  .hero {
    position: relative;
    margin-bottom: clamp(3rem, 8vw, 7rem);
  }

  .hero__name {
    font-family: 'Times New Roman', Times, serif;
    /* 108px, scaled down on narrow screens so "Mariana" never overflows. */
    font-size: min(108px, 24vw);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.05em;
    text-align: center;
    margin: 0;
    padding: clamp(2.5rem, 7vw, 6rem) 1rem;
  }
  .hero__line {
    display: block;
  }

  /* With a cover image the name sits on top of it, centered near the top. */
  .hero--has-image .hero__name {
    position: absolute;
    inset: 0 0 auto;
    padding-top: clamp(2rem, 6vw, 5rem);
    color: #fff;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.45);
    pointer-events: none;
  }

  .hero__media {
    position: relative;
    width: 100%;
  }
  /* Darken the top band so the name stays legible on light photos. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 50%;
    background: linear-gradient(rgb(0 0 0 / 0.35), transparent);
    pointer-events: none;
  }
  .hero :global(.hero__img) {
    width: 100%;
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 900px) {
    .hero :global(.hero__img) {
      aspect-ratio: auto;
      height: 100vh;
    }
  }
  /* ---------------- Series ---------------- */
  .series {
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  .series__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .series__title {
    font-size: var(--step-4);
  }
  .series__meta {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--text-dim);
    text-transform: uppercase;
  }
  .series__empty {
    color: var(--text-dim);
    font-size: var(--step-1);
  }

  /* Three-column editorial grid. When the last row would be short, the tail
     card(s) span to fill it (see .card--span* in CategoryCard) so the layout
     never leaves a gap — while keeping cards compact. */
  .series__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 720px) {
    .series__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .series__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
