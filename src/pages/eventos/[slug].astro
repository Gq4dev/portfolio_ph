---
import Layout from '../../layouts/Layout.astro'
import OptimizedImage from '../../components/OptimizedImage.astro'
import Lightbox from '../../components/Lightbox.astro'
import Cart from '../../components/Cart.astro'
import { getCatalogEvents, getCatalogEvent, getSiteSettings } from '../../lib/queries'
import { imageRatio, justifiedSizes, viewerSources } from '../../lib/image'
import { photoCount } from '../../lib/i18n'
import { metaDescription } from '../../lib/seo'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (async () => {
  const events = await getCatalogEvents()
  return events.map((e) => ({ params: { slug: e.slug } }))
}) satisfies GetStaticPaths

const { slug } = Astro.params
const [event, settings] = await Promise.all([
  getCatalogEvent(slug!),
  getSiteSettings(),
])

if (!event) {
  return Astro.redirect('/404')
}

const count = event.photos.length
const label = photoCount(count)

// Target row height per breakpoint. These are the only numbers that decide how
// dense the sheet is; they must stay in sync with --cat-row in the CSS below,
// because they are also what sizes= is derived from.
const ROW_H = { sm: 108, md: 150, lg: 210 }

// The viewer URLs are precomputed server-side (no urlFor on the client).
const items = event.photos.map((photo, i) => {
  // Natural ratio drives the justified row: no crop, so a portrait stays a
  // portrait.
  const ratio = imageRatio(photo)
  const view = viewerSources(photo)
  return {
    photo,
    code: photo.code,
    ratio,
    view,
    alt: photo.alt ?? `${event.titleEn} — ${photo.code}`,
    sizes: justifiedSizes(ratio, ROW_H),
    index: i,
  }
})

const description = metaDescription(
  `${event.titleEn} — photo catalog by Jesica Mariana.`,
  count > 0 ? `${count} watermarked previews, order by photo code.` : null
)
---

<Layout title={`${event.titleEn} — Jesica Mariana`} description={description}>
  <section class="cat-head wrap" aria-labelledby="event-title">
    <a class="cat-back" href="/eventos" data-reveal>
      <span aria-hidden="true">←</span>
      <span data-lang-block="en">Events</span
      ><span data-lang-block="es">Eventos</span>
    </a>
    <h1 class="cat-title" id="event-title" data-reveal style="--reveal-delay:0.08s">
      <span data-lang-block="en">{event.titleEn}</span
      ><span data-lang-block="es">{event.title}</span>
    </h1>
    <p class="cat-meta" data-reveal style="--reveal-delay:0.16s">
      <span class="cat-meta__num">01</span>
      <span class="rule cat-meta__rule"></span>
      <span>
        <span data-lang-block="en">{label.en}</span
        ><span data-lang-block="es">{label.es}</span>
      </span>
    </p>
    <p class="cat-note" data-reveal style="--reveal-delay:0.24s">
      <span data-lang-block="en"
        >Previews are watermarked. Tap the cart icon on a photo to add it, or
        tap the photo to open the viewer and browse the whole event. When you are done,
        send the order from the cart — every code travels in one message, and
        the files you receive are clean and full size.</span
      ><span data-lang-block="es"
        >Las vistas previas llevan marca de agua. Tocá el ícono del carrito en
        una foto para sumarla, o tocá la foto para abrir el visor y recorrer todo
        el evento. Cuando
        termines, enviá el pedido desde el carrito — todos los códigos viajan en
        un solo mensaje, y los archivos que recibís van limpios y en tamaño
        completo.</span
      >
    </p>
  </section>

  {
    items.length === 0 ? (
      <p class="cat-empty wrap" data-reveal>
        <span data-lang-block="en">There are no photos in this event yet.</span>
        <span data-lang-block="es">Todavía no hay fotos en este evento.</span>
      </p>
    ) : (
      <div class="catalog wrap">
        {items.map((it) => (
          <article
            class="lot"
            data-reveal
            style={`--r:${it.ratio.toFixed(4)};--reveal-delay:${(it.index % 4) * 0.05}s`}
          >
            <button
              class="lot__frame"
              type="button"
              data-lightbox-open
              data-index={it.index}
              data-full={it.view.src}
              data-full-srcset={it.view.srcset}
              data-full-sizes={it.view.sizes}
              data-alt={it.alt}
              data-code={it.code}
              data-cart={event.slug}
              data-event={event.title}
              data-protected
              aria-label={`Ampliar la foto ${it.code}`}
            >
              <OptimizedImage
                image={it.photo}
                alt={it.alt}
                sizes={it.sizes}
                ratio={it.ratio}
                eager={it.index < 4}
                class="lot__img"
              />
            </button>
            <span class="lot__code" aria-hidden="true">{it.code}</span>
            <button
              class="lot__pick"
              type="button"
              data-cart-pick
              data-cart={event.slug}
              data-event={event.title}
              data-code={it.code}
              data-alt={it.alt}
              aria-pressed="false"
              aria-label={`Agregar al carrito — foto ${it.code}`}
            >
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><g class="lot__pick-cart" stroke-width="1.9"><path d="M2.5 4h2.6l2.3 10.4a1 1 0 0 0 1 .8h8.8a1 1 0 0 0 1-.8L20.5 8H6"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></g><path class="lot__pick-plus" d="M12 6v12M6 12h12"/><path class="lot__pick-check" d="M5.5 12.5l4 4 9-9"/></svg>
            </button>
          </article>
        ))}
      </div>
    )
  }

  <Lightbox />
  <Cart whatsapp={settings.whatsapp} email={settings.email} />
</Layout>

<style>
  .cat-head {
    padding-top: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }
  .cat-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 0.3s var(--ease);
  }
  .cat-back:hover {
    color: var(--accent);
  }
  .cat-title {
    font-size: var(--step-6);
    font-weight: 340;
    margin: clamp(1rem, 3vw, 2rem) 0 clamp(1rem, 2vw, 1.5rem);
    line-height: 0.95;
  }
  .cat-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .cat-meta__num {
    color: var(--accent);
    font-weight: 500;
  }
  .cat-meta__rule {
    display: block;
    width: clamp(2rem, 10vw, 6rem);
    height: 1px;
    background: var(--line);
  }
  .cat-note {
    max-width: 48ch;
    margin-top: clamp(1.2rem, 3vw, 2rem);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--text-dim);
  }
  .cat-empty {
    color: var(--text-dim);
    font-size: var(--step-1);
    padding-block: 4rem;
  }

  /* Justified rows, not a uniform grid. Each row lands on one height and the
     widths follow each photo's real ratio, so nothing is cropped and a phone
     fits four across instead of one — in a 200-photo event, finding yourself
     is the whole job, and one-per-screen made that a scrolling contest.

     No layout JS and no shift: --r is Sanity's stored ratio, printed
     server-side, and the packing is plain flexbox. Inside a row every item
     gets flex-basis AND flex-grow proportional to its ratio, so the leftover
     space is shared in the same proportion, every width scales by one common
     factor, and the heights therefore match exactly.

     --cat-row and ROW_H in the frontmatter are the same number in two places:
     sizes= is derived from it. Change both or the browser picks wrong. */
  .catalog {
    --cat-row: 108px;
    --cat-gap: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--cat-gap);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  /* Eats the slack in the final row. Without it the last one or two photos
     stretch the full width and read as a feature rather than a remainder. */
  .catalog::after {
    content: '';
    flex: 99999 1 0;
  }
  @media (min-width: 640px) {
    .catalog {
      --cat-row: 150px;
      --cat-gap: 6px;
    }
  }
  @media (min-width: 1000px) {
    .catalog {
      --cat-row: 210px;
      --cat-gap: 8px;
    }
  }

  .lot {
    position: relative;
    flex: var(--r) 1 calc(var(--r) * var(--cat-row));
  }
  .lot__frame {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    overflow: hidden;
    background: var(--surface);
    cursor: zoom-in;
  }
  /* No forced ratio here any more: OptimizedImage gets the real one via its
     ratio prop, which is what keeps the row heights honest. */
  .lot :global(.lot__img) {
    transition: transform 0.9s var(--ease-out);
  }
  .lot :global(.lot__img img) {
    /* Blocks drag-to-desktop. Friction, not protection — the burnt-in
       watermark is what actually defends the work. */
    -webkit-user-drag: none;
    user-select: none;
  }
  .lot:hover :global(.lot__img),
  .lot__frame:focus-visible :global(.lot__img) {
    transform: scale(1.03);
  }

  /* Quick pick from the sheet, so choosing ten photos does not mean opening
     the viewer ten times. It sits in the corner, where a face is least likely
     to be, and stays small: the tile itself is still the target that opens
     the viewer. The hit area is larger than the visible dot via padding. */
  .lot__pick {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    color: #f4efe7;
  }
  /* Bare glyph, no badge: a shadow is what keeps it readable on a white
     dress as well as on a night sky. */
  .lot__pick svg {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.85))
      drop-shadow(0 0 1px rgba(0, 0, 0, 0.6));
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .lot__pick:hover svg,
  .lot__pick:focus-visible svg {
    transform: scale(1.12);
  }
  /* The one badge allowed: a filled check, so a picked tile reads at a
     glance against the bare + of the others. */
  .lot__pick[aria-pressed='true'] svg {
    box-sizing: content-box;
    width: 1.1rem;
    height: 1.1rem;
    padding: 0.25rem;
    color: #f4efe7;
    background: var(--accent);
    border-radius: 50%;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
  }
  /* Empty cart: every tile shows a cart, which says what the button is for.
     Once something is picked the meaning is learned, so the rest switch to a
     plain + and the picked ones to a check. */
  .lot__pick-plus,
  .lot__pick-check,
  .catalog.has-picks .lot__pick-cart,
  .catalog.has-picks .lot__pick[aria-pressed='true'] .lot__pick-plus {
    display: none;
  }
  .catalog.has-picks .lot__pick[aria-pressed='false'] .lot__pick-plus,
  .catalog.has-picks .lot__pick[aria-pressed='true'] .lot__pick-check {
    display: inline;
  }
  /* Picked tiles get a warm veil plus a thick border: obvious when scanning
     a full sheet, but the face underneath stays visible — a centred icon
     would cover exactly the thing people are looking for. */
  .lot__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--accent) 28%, transparent);
    box-shadow: inset 0 0 0 4px var(--accent);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  .lot.is-picked .lot__frame::after {
    opacity: 1;
  }

  /* The code still rides on its own photo — the pairing that commit 2c9b268
     fixed is untouched.

     Below 640px the chip is hidden too. At ~85px wide the code would be
     unreadable and the sheet is for hunting faces, not reading codes; the
     viewer names the photo the moment it opens. The button's aria-label
     carries the code at every size, so this is a visual cut, not a
     structural one. */
  .lot__code {
    display: none;
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 1;
    /* Sits over the image but never intercepts the tap: the whole tile has to
       stay one target that opens the viewer. */
    pointer-events: none;
    padding: 1.1rem 0.6rem 0.4rem 0.55rem;
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: #f4efe7;
    background: linear-gradient(
      to top right,
      rgba(10, 10, 12, 0.8),
      rgba(10, 10, 12, 0)
    );
  }
  @media (min-width: 640px) {
    .lot__code {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lot :global(.lot__img) {
      transition: none;
    }
  }
</style>

<script>
  import { getItems, hasItem, toggleItem } from '../../lib/cart'

  // Right-click "Save image as" is the laziest grab. Blocking it is a speed
  // bump, nothing more; the watermark is the real defense.
  function guardCatalogImages() {
    document
      .querySelectorAll<HTMLImageElement>('.lot__img img')
      .forEach((img) => {
        img.addEventListener('contextmenu', (e) => e.preventDefault())
      })
  }
  guardCatalogImages()
  document.addEventListener('astro:page-load', guardCatalogImages)

  // Corner pick buttons. They read the cart instead of tracking their own
  // clicks, so a photo added or removed from the viewer or the cart panel
  // shows the right state here too.
  function initPicks() {
    const picks = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-cart-pick]')
    ).filter((b) => b.dataset.ready !== 'true')
    if (!picks.length) return

    const sync = () => {
      // Any photo in the cart counts, even from another event: the visitor
      // has already learned what the button does.
      document
        .querySelector('.catalog')
        ?.classList.toggle('has-picks', getItems().length > 0)
      document
        .querySelectorAll<HTMLButtonElement>('[data-cart-pick]')
        .forEach((b) => {
          const code = b.dataset.code || ''
          const inCart = hasItem(b.dataset.cart || '', code)
          b.setAttribute('aria-pressed', String(inCart))
          b.setAttribute(
            'aria-label',
            inCart ? `Quitar del carrito — foto ${code}` : `Agregar al carrito — foto ${code}`
          )
          b.closest('.lot')?.classList.toggle('is-picked', inCart)
        })
    }

    picks.forEach((b) => {
      b.dataset.ready = 'true'
      b.addEventListener('click', () => {
        const thumb = b.closest('.lot')?.querySelector('img')
        toggleItem({
          event: b.dataset.cart || '',
          eventTitle: b.dataset.event || '',
          code: b.dataset.code || '',
          thumb: thumb?.currentSrc || thumb?.src || '',
          alt: b.dataset.alt || '',
        })
      })
    })

    const ac = new AbortController()
    document.addEventListener('cart:change', sync, { signal: ac.signal })
    document.addEventListener('astro:before-swap', () => ac.abort(), {
      once: true,
    })
    sync()
  }
  initPicks()
  document.addEventListener('astro:page-load', initPicks)
</script>
